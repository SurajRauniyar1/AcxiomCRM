
@model AcxiomCRM.Web.Models.Activity

@{
    ViewData["Title"] = "Delete Activity";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm border-danger">

                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Delete Activity</h4>
                </div>

                <div class="card-body p-4">

                    <h5>Are you sure you want to delete this activity?</h5>
                    <p class="text-muted">This action cannot be undone.</p>

                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Activity Type</dt>
                        <dd class="col-sm-8">@Model.ActivityType</dd>

                        <dt class="col-sm-4">Subject</dt>
                        <dd class="col-sm-8">@Model.Subject</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@(Model.Description ?? "No description")</dd>

                        <dt class="col-sm-4">Activity Date</dt>
                        <dd class="col-sm-8">
                            @Model.ActivityDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@Model.Status</dd>
                    </dl>

                    <form asp-action="Delete"
                          asp-route-id="@Model.ActivityId"
                          method="post">

                        <button type="submit" class="btn btn-danger">
                            Confirm Delete
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">Cancel</a>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
