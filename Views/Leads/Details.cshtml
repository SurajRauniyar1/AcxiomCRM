
@model AcxiomCRM.Web.Models.Lead

@{
    ViewData["Title"] = "Lead Details";
    var convertedCustomer =
        ViewBag.ConvertedCustomer as AcxiomCRM.Web.Models.Customer;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Lead Details</h2>
            <p class="text-muted">Complete lead information.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Leads
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h5>Basic Information</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Lead Code</dt>
                <dd class="col-sm-9">@Model.LeadCode</dd>

                <dt class="col-sm-3">Lead Name</dt>
                <dd class="col-sm-9">@Model.LeadName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@Model.Phone</dd>

                <dt class="col-sm-3">Company</dt>
                <dd class="col-sm-9">@Model.CompanyName</dd>

                <dt class="col-sm-3">Source</dt>
                <dd class="col-sm-9">@Model.Source</dd>

                <dt class="col-sm-3">Expected Value</dt>
                <dd class="col-sm-9">@Model.ExpectedValue.ToString("N2")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Assigned To</dt>
                <dd class="col-sm-9">
                    @(ViewBag.AssignedUser ?? "Unassigned")
                </dd>
            </dl>

            <hr />

            <h5>Additional Information</h5>

            <dl class="row mt-3">
                <dt class="col-sm-3">Notes</dt>
                <dd class="col-sm-9">@Model.Notes</dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">
                    @Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                </dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9">@Model.CreatedBy</dd>

                <dt class="col-sm-3">Converted</dt>
                <dd class="col-sm-9">@(Model.IsConverted ? "Yes" : "No")</dd>
            </dl>

            @if (convertedCustomer != null)
            {
                <div class="alert alert-success">
                    <strong>Converted Customer:</strong>
                    @convertedCustomer.CustomerCode —
                    @convertedCustomer.CustomerName

                    <a asp-controller="Customers"
                       asp-action="Details"
                       asp-route-id="@convertedCustomer.CustomerId">
                        View Customer
                    </a>
                </div>
            }

            @if (!Model.IsConverted)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.LeadId"
                   class="btn btn-primary">Edit Lead</a>

                @if (Model.Status == "Qualified")
                {
                    <a asp-action="Convert"
                       asp-route-id="@Model.LeadId"
                       class="btn btn-success">Convert to Customer</a>
                }
            }

            <a asp-action="Index"
               class="btn btn-outline-secondary">Back</a>

        </div>
    </div>
</div>
