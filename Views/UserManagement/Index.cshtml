
@model AcxiomCRM.Web.ViewModels.UserManagementViewModel

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">User Management</h2>
            <p class="text-muted mb-0">
                Manage users, roles and account access.
            </p>
        </div>

        <a asp-controller="UserManagement"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add New User
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted mb-1">Total Users</p>
                    <h3 class="fw-bold">@Model.Users.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted mb-1">Active Users</p>
                    <h3 class="fw-bold text-success">
                        @Model.Users.Count(u => u.IsActive)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted mb-1">Administrators</p>
                    <h3 class="fw-bold text-primary">
                        @Model.Users.Count(u => u.Role == "Admin")
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">Registered Users</h5>
        </div>

        <div class="card-body">

            @if (!Model.Users.Any())
            {
                <div class="text-center py-5">
                    <h5>No users found</h5>
                    <p class="text-muted">
                        Create your first user account.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @(string.IsNullOrWhiteSpace(user.FullName)
                                            ? "Not provided"
                                            : user.FullName)
                                    </td>

                                    <td>@user.Email</td>

                                    <td>
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge bg-danger">
                                                Admin
                                            </span>
                                        }
                                        else if (user.Role == "Manager")
                                        {
                                            <span class="badge bg-primary">
                                                Manager
                                            </span>
                                        }
                                        else if (user.Role == "SalesExecutive")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Sales Executive
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                No Role
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="EditRole"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Change Role
                                        </a>

                                        <form asp-action="ToggleStatus"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to change this account status?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                @(user.IsActive ? "Deactivate" : "Activate")
                                            </button>

                                        </form>

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>
