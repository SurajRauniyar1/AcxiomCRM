
@model AcxiomCRM.Web.Models.Lead

@{
    ViewData["Title"] = "Convert Lead";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm border-success">

                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Convert Lead to Customer</h4>
                </div>

                <div class="card-body p-4">

                    <h5>Confirm lead conversion</h5>

                    <p class="text-muted">
                        This will create a customer record using the lead's
                        information and mark the lead as Converted.
                    </p>

                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Lead Code</dt>
                        <dd class="col-sm-8">@Model.LeadCode</dd>

                        <dt class="col-sm-4">Lead Name</dt>
                        <dd class="col-sm-8">@Model.LeadName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>

                        <dt class="col-sm-4">Company</dt>
                        <dd class="col-sm-8">@Model.CompanyName</dd>

                        <dt class="col-sm-4">Expected Value</dt>
                        <dd class="col-sm-8">@Model.ExpectedValue.ToString("N2")</dd>
                    </dl>

                    <div class="alert alert-info">
                        The new customer will receive an automatically
                        generated customer code.
                    </div>

                    <form asp-action="ConvertConfirmed"
                          asp-route-id="@Model.LeadId"
                          method="post">

                        <button type="submit" class="btn btn-success">
                            Confirm Conversion
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.LeadId"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
