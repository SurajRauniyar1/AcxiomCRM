
@model AcxiomCRM.Web.Models.Opportunity

@{
    ViewData["Title"] = "Opportunity Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Opportunity Details</h2>
            <p class="text-muted">Complete sales opportunity information.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Opportunities</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h5>Opportunity Information</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Opportunity ID</dt>
                <dd class="col-sm-9">@Model.OpportunityId</dd>

                <dt class="col-sm-3">Opportunity Name</dt>
                <dd class="col-sm-9">@Model.OpportunityName</dd>

                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">@(ViewBag.CustomerName ?? "Not linked")</dd>

                <dt class="col-sm-3">Lead</dt>
                <dd class="col-sm-9">@(ViewBag.LeadName ?? "Not linked")</dd>
            </dl>

            <hr />
            <h5>Deal Information</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Deal Amount</dt>
                <dd class="col-sm-9">@Model.Amount.ToString("C2")</dd>

                <dt class="col-sm-3">Sales Stage</dt>
                <dd class="col-sm-9">@Model.Stage</dd>

                <dt class="col-sm-3">Probability</dt>
                <dd class="col-sm-9">@Model.Probability%</dd>

                <dt class="col-sm-3">Weighted Value</dt>
                <dd class="col-sm-9">
                    <strong class="text-success">@Model.WeightedValue.ToString("C2")</strong>
                </dd>

                <dt class="col-sm-3">Expected Close Date</dt>
                <dd class="col-sm-9">
                    @Model.ExpectedCloseDate.ToLocalTime().ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Status == "Won" ? "bg-success" :
                                          Model.Status == "Lost" ? "bg-danger" :
                                          Model.Status == "Closed" ? "bg-secondary" :
                                          "bg-primary")">
                        @Model.Status
                    </span>
                </dd>

                <dt class="col-sm-3">Assigned To</dt>
                <dd class="col-sm-9">@(ViewBag.AssignedUser ?? "Unassigned")</dd>
            </dl>

            <hr />
            <h5>Audit Information</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">
                    @Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                </dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9">@Model.CreatedBy</dd>

                <dt class="col-sm-3">Modified Date</dt>
                <dd class="col-sm-9">
                    @(Model.ModifiedDate?.ToLocalTime().ToString("dd MMM yyyy hh:mm tt") ?? "Not modified")
                </dd>
            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.OpportunityId"
               class="btn btn-primary">Edit Opportunity</a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
</div>
