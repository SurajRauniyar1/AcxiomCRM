
@model IEnumerable<AcxiomCRM.Web.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";

    var userNames =
        ViewBag.UserNames as Dictionary<string, string>
        ?? new Dictionary<string, string>();

    var actions =
        ViewBag.Actions as List<string>
        ?? new List<string>();

    var entities =
        ViewBag.Entities as List<string>
        ?? new List<string>();
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Audit Logs</h2>
            <p class="text-muted mb-0">
                Monitor and review system activities.
            </p>
        </div>

        <span class="badge bg-dark">
            Total Records: @ViewBag.TotalRecords
        </span>

    </div>

    <!-- TEMPORARY DATABASE DIAGNOSTICS -->
    <div class="alert alert-info">
        <strong>Database Diagnostics</strong>
        <hr />

        Database:
        <strong>@ViewBag.DatabaseName</strong>

        <br />

        Server:
        <strong>@ViewBag.DatabaseServer</strong>

        <br />

        Total Audit Records from EF Core:
        <strong>@ViewBag.AuditCount</strong>
    </div>

    <!-- FILTER SECTION -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewData["Search"]"
                               class="form-control"
                               placeholder="Entity, Record ID or IP address" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">
                            Action
                        </label>

                        <select name="action"
                                class="form-select">

                            <option value="">
                                All Actions
                            </option>

                            @foreach (var item in actions)
                            {
                                <option value="@item"
                                        selected="@(ViewData["Action"]?.ToString() == item)">
                                    @item
                                </option>
                            }

                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">
                            Entity
                        </label>

                        <select name="entity"
                                class="form-select">

                            <option value="">
                                All Entities
                            </option>

                            @foreach (var item in entities)
                            {
                                <option value="@item"
                                        selected="@(ViewData["Entity"]?.ToString() == item)">
                                    @item
                                </option>
                            }

                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">
                            User
                        </label>

                        <select name="userId"
                                class="form-select">

                            <option value="">
                                All Users
                            </option>

                            @foreach (var user in ViewBag.Users)
                            {
                                <option value="@user.Id"
                                        selected="@(ViewData["UserId"]?.ToString() == user.Id)">
                                    @user.Email
                                </option>
                            }

                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            From Date
                        </label>

                        <input type="date"
                               name="fromDate"
                               value="@ViewData["FromDate"]"
                               class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            To Date
                        </label>

                        <input type="date"
                               name="toDate"
                               value="@ViewData["ToDate"]"
                               class="form-control" />
                    </div>

                    <div class="col-md-6 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Apply Filters
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- AUDIT LOG TABLE -->
    <div class="card shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Record ID</th>
                        <th>IP Address</th>
                        <th>Details</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            var actionClass = log.Action switch
                            {
                                "Create" => "bg-success",
                                "Update" => "bg-primary",
                                "Delete" => "bg-danger",
                                "Convert" => "bg-info text-dark",
                                _ => "bg-secondary"
                            };

                            var userName =
                                log.UserId != null &&
                                userNames.TryGetValue(
                                    log.UserId,
                                    out var email)
                                    ? email
                                    : "Unknown User";

                            <tr>

                                <td>
                                    @log.AuditLogId
                                </td>

                                <td>
                                    @log.CreatedDate.ToString("dd MMM yyyy")
                                    <br />

                                    <small class="text-muted">
                                        @log.CreatedDate.ToString("hh:mm:ss tt")
                                    </small>
                                </td>

                                <td>
                                    @userName
                                </td>

                                <td>
                                    <span class="badge @actionClass">
                                        @log.Action
                                    </span>
                                </td>

                                <td>
                                    @log.EntityName
                                </td>

                                <td>
                                    @log.RecordId
                                </td>

                                <td>
                                    @(log.IpAddress ?? "-")
                                </td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@log.AuditLogId"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center py-5 text-muted">
                                No audit records found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- PAGINATION -->
    @if ((int)ViewBag.TotalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@ViewData["Search"]"
                       asp-route-action="@ViewData["Action"]"
                       asp-route-entity="@ViewData["Entity"]"
                       asp-route-userId="@ViewData["UserId"]"
                       asp-route-fromDate="@ViewData["FromDate"]"
                       asp-route-toDate="@ViewData["ToDate"]"
                       asp-route-page="@(ViewBag.CurrentPage - 1)">
                        Previous
                    </a>

                </li>

                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@ViewData["Search"]"
                           asp-route-action="@ViewData["Action"]"
                           asp-route-entity="@ViewData["Entity"]"
                           asp-route-userId="@ViewData["UserId"]"
                           asp-route-fromDate="@ViewData["FromDate"]"
                           asp-route-toDate="@ViewData["ToDate"]"
                           asp-route-page="@i">
                            @i
                        </a>

                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@ViewData["Search"]"
                       asp-route-action="@ViewData["Action"]"
                       asp-route-entity="@ViewData["Entity"]"
                       asp-route-userId="@ViewData["UserId"]"
                       asp-route-fromDate="@ViewData["FromDate"]"
                       asp-route-toDate="@ViewData["ToDate"]"
                       asp-route-page="@(ViewBag.CurrentPage + 1)">
                        Next
                    </a>

                </li>

            </ul>

        </nav>
    }

</div>
