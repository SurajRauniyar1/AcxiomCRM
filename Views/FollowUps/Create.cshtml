
@model AcxiomCRM.Web.Models.FollowUp

@{
    ViewData["Title"] = "Schedule Follow-up";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2>Schedule Follow-up</h2>
                    <p class="text-muted">Create a new customer or lead follow-up.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to Follow-ups</a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <h5 class="mb-3">Follow-up Information</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FollowUpDate" class="form-label">Date and Time</label>
                                <input asp-for="FollowUpDate"
                                       type="datetime-local"
                                       class="form-control"
                                       asp-format="{0:yyyy-MM-ddTHH:mm}" />
                                <span asp-validation-for="FollowUpDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FollowUpType" class="form-label">Follow-up Type</label>
                                <select asp-for="FollowUpType" class="form-select">
                                    <option value="Call">Call</option>
                                    <option value="Meeting">Meeting</option>
                                    <option value="Email">Email</option>
                                    <option value="Task">Task</option>
                                </select>
                                <span asp-validation-for="FollowUpType" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerId" class="form-label">Related Customer</label>
                                <select asp-for="CustomerId"
                                        asp-items="ViewBag.Customers"
                                        class="form-select"
                                        id="customerSelect">
                                    <option value="">-- Select Customer --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LeadId" class="form-label">Related Lead</label>
                                <select asp-for="LeadId"
                                        asp-items="ViewBag.Leads"
                                        class="form-select"
                                        id="leadSelect">
                                    <option value="">-- Select Lead --</option>
                                </select>
                                <span asp-validation-for="LeadId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="AssignedTo" class="form-label">Assign To</label>
                                <select asp-for="AssignedTo"
                                        asp-items="ViewBag.AssignedUsers"
                                        class="form-select">
                                    <option value="">-- Unassigned --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />

                        <div class="mb-4">
                            <label asp-for="Remarks" class="form-label"></label>
                            <textarea asp-for="Remarks"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter follow-up notes or discussion details..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger"></span>
                        </div>

                        <input type="hidden" asp-for="Status" value="Planned" />

                        <button type="submit" class="btn btn-primary">Schedule Follow-up</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const customerSelect = document.getElementById("customerSelect");
        const leadSelect = document.getElementById("leadSelect");

        customerSelect.addEventListener("change", function () {
            if (this.value) {
                leadSelect.value = "";
            }
        });

        leadSelect.addEventListener("change", function () {
            if (this.value) {
                customerSelect.value = "";
            }
        });
    </script>
}
