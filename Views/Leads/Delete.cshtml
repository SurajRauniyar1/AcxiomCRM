
@model AcxiomCRM.Web.Models.Lead

@{
    ViewData["Title"] = "Delete Lead";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm border-danger">

                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Delete Lead</h4>
                </div>

                <div class="card-body p-4">

                    <h5>Are you sure you want to delete this lead?</h5>

                    <p class="text-danger">
                        This action cannot be undone.
                    </p>

                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Lead Code</dt>
                        <dd class="col-sm-8">@Model.LeadCode</dd>

                        <dt class="col-sm-4">Lead Name</dt>
                        <dd class="col-sm-8">@Model.LeadName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>

                        <dt class="col-sm-4">Company</dt>
                        <dd class="col-sm-8">@Model.CompanyName</dd>

                        <dt class="col-sm-4">Expected Value</dt>
                        <dd class="col-sm-8">
                            @Model.ExpectedValue.ToString("N2")
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@Model.Status</dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete"
                          asp-route-id="@Model.LeadId"
                          method="post">

                        <input type="hidden" asp-for="LeadId" />

                        <button type="submit"
                                class="btn btn-danger">
                            Yes, Delete Lead
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
