
@model AcxiomCRM.Web.Models.Activity

@{
    ViewData["Title"] = "Activity Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Activity Details</h2>
            <p class="text-muted">Complete activity information.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Activities</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h5>Activity Information</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Activity ID</dt>
                <dd class="col-sm-9">@Model.ActivityId</dd>

                <dt class="col-sm-3">Activity Type</dt>
                <dd class="col-sm-9">@Model.ActivityType</dd>

                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9">@Model.Subject</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@(Model.Description ?? "No description")</dd>

                <dt class="col-sm-3">Activity Date</dt>
                <dd class="col-sm-9">
                    @Model.ActivityDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                </dd>
            </dl>

            <hr />
            <h5>Related Record</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">@(ViewBag.CustomerName ?? "Not linked")</dd>

                <dt class="col-sm-3">Lead</dt>
                <dd class="col-sm-9">@(ViewBag.LeadName ?? "Not linked")</dd>

                <dt class="col-sm-3">Assigned To</dt>
                <dd class="col-sm-9">@(ViewBag.AssignedUser ?? "Unassigned")</dd>
            </dl>

            <hr />
            <h5>Status and Audit Information</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Status == "Completed" ? "bg-success" :
                                          Model.Status == "Cancelled" ? "bg-danger" :
                                          Model.Status == "In Progress" ? "bg-info text-dark" :
                                          "bg-primary")">
                        @Model.Status
                    </span>
                </dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">
                    @Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                </dd>

                <dt class="col-sm-3">Created By</dt>
                <dd class="col-sm-9">@Model.CreatedBy</dd>

                <dt class="col-sm-3">Modified Date</dt>
                <dd class="col-sm-9">
                    @(Model.ModifiedDate?.ToLocalTime().ToString("dd MMM yyyy hh:mm tt") ?? "Not modified")
                </dd>
            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.ActivityId"
               class="btn btn-primary">Edit Activity</a>

            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
</div>
