
@model AcxiomCRM.Web.Models.Activity

@{
    ViewData["Title"] = "Edit Activity";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2>Edit Activity</h2>
                    <p class="text-muted">Update activity information.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to Activities</a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form asp-action="Edit"
                          asp-route-id="@Model.ActivityId"
                          method="post">

                        <input type="hidden" asp-for="ActivityId" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ActivityType" class="form-label">Activity Type</label>
                                <select asp-for="ActivityType" class="form-select">
                                    <option value="Call">Call</option>
                                    <option value="Meeting">Meeting</option>
                                    <option value="Email">Email</option>
                                    <option value="Task">Task</option>
                                </select>
                                <span asp-validation-for="ActivityType" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label">Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Planned">Planned</option>
                                    <option value="In Progress">In Progress</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Subject" class="form-label"></label>
                            <input asp-for="Subject" class="form-control" />
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ActivityDate" class="form-label">Activity Date and Time</label>
                            <input asp-for="ActivityDate"
                                   type="datetime-local"
                                   class="form-control"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}" />
                            <span asp-validation-for="ActivityDate" class="text-danger"></span>
                        </div>

                        <hr />
                        <h5 class="mb-3">Related Record</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerId" class="form-label">Customer</label>
                                <select asp-for="CustomerId"
                                        asp-items="ViewBag.Customers"
                                        class="form-select"
                                        id="customerSelect">
                                    <option value="">-- Select Customer --</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LeadId" class="form-label">Lead</label>
                                <select asp-for="LeadId"
                                        asp-items="ViewBag.Leads"
                                        class="form-select"
                                        id="leadSelect">
                                    <option value="">-- Select Lead --</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AssignedTo" class="form-label">Assign To</label>
                            <select asp-for="AssignedTo"
                                    asp-items="ViewBag.AssignedUsers"
                                    class="form-select">
                                <option value="">-- Unassigned --</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary">Update Activity</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const customerSelect = document.getElementById("customerSelect");
        const leadSelect = document.getElementById("leadSelect");

        customerSelect.addEventListener("change", function () {
            if (this.value) leadSelect.value = "";
        });

        leadSelect.addEventListener("change", function () {
            if (this.value) customerSelect.value = "";
        });
    </script>
}
