
@model AcxiomCRM.Web.Models.Opportunity

@{
    ViewData["Title"] = "Delete Opportunity";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Delete Opportunity</h4>
                </div>

                <div class="card-body p-4">

                    <h5>Are you sure you want to delete this opportunity?</h5>
                    <p class="text-muted">This action cannot be undone.</p>

                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Opportunity Name</dt>
                        <dd class="col-sm-8">@Model.OpportunityName</dd>

                        <dt class="col-sm-4">Amount</dt>
                        <dd class="col-sm-8">@Model.Amount.ToString("C2")</dd>

                        <dt class="col-sm-4">Stage</dt>
                        <dd class="col-sm-8">@Model.Stage</dd>

                        <dt class="col-sm-4">Probability</dt>
                        <dd class="col-sm-8">@Model.Probability%</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@Model.Status</dd>

                        <dt class="col-sm-4">Expected Close</dt>
                        <dd class="col-sm-8">
                            @Model.ExpectedCloseDate.ToLocalTime().ToString("dd MMM yyyy")
                        </dd>
                    </dl>

                    <form asp-action="Delete"
                          asp-route-id="@Model.OpportunityId"
                          method="post">

                        <button type="submit" class="btn btn-danger">
                            Confirm Delete
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">Cancel</a>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
