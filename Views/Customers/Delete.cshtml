@model AcxiomCRM.Web.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Delete Customer</h4>
                </div>

                <div class="card-body p-4">
                    <h5>Are you sure you want to delete this customer?</h5>

                    <p class="text-danger">
                        This action cannot be undone.
                    </p>

                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Customer Code</dt>
                        <dd class="col-sm-8">@Model.CustomerCode</dd>

                        <dt class="col-sm-4">Customer Name</dt>
                        <dd class="col-sm-8">@Model.CustomerName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>

                        <dt class="col-sm-4">Company</dt>
                        <dd class="col-sm-8">@Model.CompanyName</dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" asp-route-id="@Model.CustomerId" method="post">

                        <input type="hidden" asp-for="CustomerId" />

                        <button type="submit" class="btn btn-danger">
                            Yes, Delete Customer
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
