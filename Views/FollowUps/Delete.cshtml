
@model AcxiomCRM.Web.Models.FollowUp

@{
    ViewData["Title"] = "Delete Follow-up";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Delete Follow-up</h4>
                </div>

                <div class="card-body p-4">

                    <h5>Are you sure you want to delete this follow-up?</h5>

                    <p class="text-muted">
                        This action cannot be undone.
                    </p>

                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Follow-up ID</dt>
                        <dd class="col-sm-8">@Model.FollowUpId</dd>

                        <dt class="col-sm-4">Date</dt>
                        <dd class="col-sm-8">
                            @Model.FollowUpDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                        </dd>

                        <dt class="col-sm-4">Type</dt>
                        <dd class="col-sm-8">@Model.FollowUpType</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@Model.Status</dd>

                        <dt class="col-sm-4">Remarks</dt>
                        <dd class="col-sm-8">@Model.Remarks</dd>
                    </dl>

                    <form asp-action="Delete"
                          asp-route-id="@Model.FollowUpId"
                          method="post">

                        <button type="submit" class="btn btn-danger">
                            Confirm Delete
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">Cancel</a>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
