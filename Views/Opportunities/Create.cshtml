
@model AcxiomCRM.Web.Models.Opportunity

@{
    ViewData["Title"] = "Create Opportunity";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2>Create Opportunity</h2>
                    <p class="text-muted">Add a new sales opportunity.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to Opportunities</a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <h5 class="mb-3">Opportunity Information</h5>

                        <div class="mb-3">
                            <label asp-for="OpportunityName" class="form-label"></label>
                            <input asp-for="OpportunityName" class="form-control"
                                   placeholder="Enter opportunity name" />
                            <span asp-validation-for="OpportunityName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerId" class="form-label">Related Customer</label>
                                <select asp-for="CustomerId"
                                        asp-items="ViewBag.Customers"
                                        class="form-select"
                                        id="customerSelect">
                                    <option value="">-- Select Customer --</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LeadId" class="form-label">Related Lead</label>
                                <select asp-for="LeadId"
                                        asp-items="ViewBag.Leads"
                                        class="form-select"
                                        id="leadSelect">
                                    <option value="">-- Select Lead --</option>
                                </select>
                            </div>
                        </div>

                        <hr />
                        <h5 class="mb-3">Deal Information</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Amount" class="form-label">Deal Amount</label>
                                <input asp-for="Amount" type="number" step="0.01"
                                       min="0.01" class="form-control" />
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Probability" class="form-label">Probability (%)</label>
                                <input asp-for="Probability" type="number"
                                       min="0" max="100" class="form-control" />
                                <span asp-validation-for="Probability" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Stage" class="form-label"></label>
                                <select asp-for="Stage" class="form-select">
                                    <option value="Qualification">Qualification</option>
                                    <option value="Proposal">Proposal</option>
                                    <option value="Negotiation">Negotiation</option>
                                    <option value="Won">Won</option>
                                    <option value="Lost">Lost</option>
                                </select>
                                <span asp-validation-for="Stage" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date</label>
                                <input asp-for="ExpectedCloseDate"
                                       type="date" class="form-control"
                                       asp-format="{0:yyyy-MM-dd}" />
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="AssignedTo" class="form-label">Assign To</label>
                                <select asp-for="AssignedTo"
                                        asp-items="ViewBag.AssignedUsers"
                                        class="form-select">
                                    <option value="">-- Unassigned --</option>
                                </select>
                            </div>
                        </div>

                        <input type="hidden" asp-for="Status" value="Open" />

                        <button type="submit" class="btn btn-primary">Create Opportunity</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const customerSelect = document.getElementById("customerSelect");
        const leadSelect = document.getElementById("leadSelect");

        customerSelect.addEventListener("change", function () {
            if (this.value) leadSelect.value = "";
        });

        leadSelect.addEventListener("change", function () {
            if (this.value) customerSelect.value = "";
        });
    </script>
}
