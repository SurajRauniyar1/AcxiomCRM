
@model AcxiomCRM.Web.ViewModels.EditUserRoleViewModel

@{
    ViewData["Title"] = "Change User Role";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 fw-bold">Change User Role</h4>
                </div>

                <div class="card-body p-4">

                    <form asp-action="EditRole" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="UserId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                User Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   readonly />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Role"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="Role" class="form-select">
                                <option value="Admin">Admin</option>
                                <option value="Manager">Manager</option>
                                <option value="SalesExecutive">
                                    Sales Executive
                                </option>
                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
