@model AcxiomCRM.Web.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Customer Details</h2>
            <p class="text-muted">Complete customer information</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Customers
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h5>Basic Information</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Customer Code</dt>
                <dd class="col-sm-9">@Model.CustomerCode</dd>

                <dt class="col-sm-3">Customer Name</dt>
                <dd class="col-sm-9">@Model.CustomerName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@Model.Phone</dd>

                <dt class="col-sm-3">Company</dt>
                <dd class="col-sm-9">@Model.CompanyName</dd>
            </dl>

            <h5 class="mt-4">Address Information</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@Model.Address</dd>

                <dt class="col-sm-3">City</dt>
                <dd class="col-sm-9">@Model.City</dd>

                <dt class="col-sm-3">State</dt>
                <dd class="col-sm-9">@Model.State</dd>
            </dl>

            <h5 class="mt-4">Additional Information</h5>
            <hr />

            <dl class="row">
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Notes</dt>
                <dd class="col-sm-9">@Model.Notes</dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">
                    @Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                </dd>
            </dl>

            <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary">
                Edit Customer
            </a>

        </div>
    </div>
</div>
